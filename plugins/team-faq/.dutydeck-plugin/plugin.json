{
  "name": "team-faq",
  "version": "0.1.0",
  "description": "团队答疑：群里有人问到指定服务或流程时，按 runbook 判断要不要接、按 runbook 回答。",
  "scenarios": "scenarios",
  "providers": "index.mjs",
  "userConfig": {
    "docs_dir": {
      "description": "runbook 所在目录（Markdown）"
    }
  },
  "apiVersion": 1,
  "bindingConfig": {
    "docs_dir": {
      "type": "string",
      "required": true,
      "description": "Runbook directory for this Bot, group or workspace"
    }
  },
  "skills": "skills",
  "requiredSkills": [
    "team-faq/answer"
  ],
  "skillResources": {
    "answer": [
      {
        "path": "references/output-policy.md",
        "maxBytes": 4096
      }
    ]
  }
}
