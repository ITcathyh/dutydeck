      "expected": { "kind": "command", "operation": "group.messages", "params": { "query": { "truthy": true } } }
    },
    {
      "id": "R59",
      "judge": "agent",
      "utterance": "弄完记得发我一下结果",
      "scenario": { "chatType": "group", "activeTask": true, "context": "Agent 正在跑任务，最终答复本来就会发回原话题" },
      "expected": { "kind": "none" }
    },
    {
      "id": "R60",
      "judge": "agent",
      "utterance": "@李四 你告诉他一声，就说排查完了，是配置的问题",
      "scenario": { "chatType": "group", "activeTask": true, "context": "消息里 @ 了李四" },
