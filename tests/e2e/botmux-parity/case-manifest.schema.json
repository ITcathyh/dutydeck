{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dockmux.invalid/schemas/botmux-parity-cases-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "default_action", "safety_contract", "required_coverage", "cases"],
  "properties": {
    "schema_version": { "const": 1 },
    "suite_id": { "const": "botmux-parity-v1" },
    "default_action": { "const": "self_check_only" },
    "safety_contract": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "required_coverage": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9_]+$" }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "coverage", "execution", "expectation"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "coverage": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
          "execution": { "enum": ["offline", "remote_opt_in", "real_lark_opt_in", "expected_blocked"] },
          "expectation": { "enum": ["pass", "expected_blocked", "skip"] },
          "command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "required_env": { "type": "array", "items": { "type": "string" } },
          "reason_code": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "blocked_by": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "fixtures": { "type": "array", "items": { "type": "string" } },
          "evidence_sources": { "type": "array", "items": { "type": "string" } },
          "supporting_evidence": { "type": "array", "items": { "type": "string" } },
          "assertions": { "type": "array", "items": { "type": "string" } },
          "safety": { "type": "array", "items": { "type": "string" } },
          "preflight_schema": { "type": "string" }
        }
      }
    }
  }
}
