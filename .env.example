AGENTDOCK_HOST=0.0.0.0
AGENTDOCK_PORT=4310
AGENTDOCK_DATABASE_URL=./.agentdock/agentdock.db
AGENTDOCK_DEFAULT_CWD=/absolute/path/to/your/project
AGENTDOCK_DRIVER_IDLE_TIMEOUT_MS=21600000
AGENTDOCK_CLEANUP_INTERVAL_MS=300000

# Optional Lark card channel. Never commit real credentials.
LARK_APP_ID=cli_xxx
LARK_APP_SECRET=replace_me
LARK_RECEIVE_ID=user@example.com
LARK_RECEIVE_ID_TYPE=email
# Optional group default; when present, takes precedence over LARK_RECEIVE_ID.
# LARK_CHAT_ID=oc_xxx
LARK_AGENT_NAME=AgentDock
# LARK_OPEN_API_BASE_URL=https://open.feishu.cn

# Optional custom agents. Entries with an existing built-in id override it.
# TraeX must expose an ACP server over stdio, directly or through a bridge.
AGENTDOCK_AGENTS_JSON=[{"id":"traex","name":"TraeX","command":"/absolute/path/to/traex","args":["acp","serve"],"protocol":"acp","cwd":"/absolute/path/to/project","env":{},"permissionMode":"ask","timeout":600,"capabilities":{"pause":false,"resume":true},"builtin":false}]
