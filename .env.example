DOCKMUX_HOST=127.0.0.1
DOCKMUX_PORT=4310
DOCKMUX_DATABASE_URL=./.dockmux/dockmux.db
DOCKMUX_DEFAULT_CWD=/absolute/path/to/your/project
DOCKMUX_DRIVER_IDLE_TIMEOUT_MS=21600000
DOCKMUX_CLEANUP_INTERVAL_MS=300000
# Set DOCKMUX_HOST=0.0.0.0 explicitly for LAN access. Remote browser access
# requires the token shown by `dockmux auth token`.
# DOCKMUX_LOCAL_ONLY=true

# Optional Lark card channel. Never commit real credentials.
LARK_APP_ID=cli_xxx
LARK_APP_SECRET=replace_me
LARK_RECEIVE_ID=user@example.com
LARK_RECEIVE_ID_TYPE=email
# Optional group default; when present, takes precedence over LARK_RECEIVE_ID.
# LARK_CHAT_ID=oc_xxx
LARK_AGENT_NAME=Dockmux
# LARK_OPEN_API_BASE_URL=https://open.feishu.cn

# Optional custom agents. Entries with an existing built-in id override it.
# The command must expose an ACP server over stdio, directly or through a bridge.
DOCKMUX_AGENTS_JSON=[{"id":"custom","name":"Custom ACP","command":"/absolute/path/to/custom-agent","args":["acp","serve"],"protocol":"acp","cwd":"/absolute/path/to/project","env":{},"permissionMode":"ask","timeout":600,"capabilities":{"pause":false,"resume":true},"builtin":false}]
