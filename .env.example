# 手工编辑本文件是可选路径。推荐直接运行 `dutydeck setup`：
# 它会探测本机 Agent CLI、校验工作目录、可选绑定飞书机器人，并把结果写进 .env。
# 向导幂等可重跑，只改它管理的键，不会动你手写的注释和其他变量。
# 配好之后用 `dutydeck doctor` 体检。

DUTYDECK_HOST=127.0.0.1
DUTYDECK_PORT=4310
DUTYDECK_DATABASE_URL=./.dutydeck/dutydeck.db
DUTYDECK_DEFAULT_CWD=/absolute/path/to/your/project
DUTYDECK_DRIVER_IDLE_TIMEOUT_MS=21600000
DUTYDECK_CLEANUP_INTERVAL_MS=300000
# Set DUTYDECK_HOST=0.0.0.0 explicitly for LAN access. Remote browser access
# requires the token shown by `dutydeck auth token`.
# DUTYDECK_LOCAL_ONLY=true

# Optional Lark card channel. Never commit real credentials.
# `dutydeck setup --lark-app-id cli_xxx` 会自动配置权限、事件、回调并提交版本，
# 免去手工在开放平台点选。App Secret 属于机密，请用 `dutydeck secret set` 录入，
# 不要写进任何会被提交的文件。
LARK_APP_ID=cli_xxx
LARK_APP_SECRET=replace_me
LARK_RECEIVE_ID=user@example.com
LARK_RECEIVE_ID_TYPE=email
# Optional group default; when present, takes precedence over LARK_RECEIVE_ID.
# LARK_CHAT_ID=oc_xxx
LARK_AGENT_NAME=Dutydeck
# LARK_OPEN_API_BASE_URL=https://open.feishu.cn

# 飞书 OpenAPI 调用网关：限流、重试与熔断。全部可选，留空或非法值（NaN / 负数 /
# 0，除 RETRY_MAX_ATTEMPTS 外）一律回退默认值。每次调用现读 env，所以 daemon
# 运行期间改这些值即可生效，不需要重启。
#
# 令牌桶限流。QPS 必须 > 0——0 QPS 会让所有卡片更新永久挂死，因此非法值会被拒绝
# 并回退默认。BURST 省略时等于 QPS。
# LARK_API_QPS=15
# LARK_API_BURST=15
# 重试：仅对瞬时失败生效（频控码 230049 / 230020 / 99991400 与网络类错误）；
# INVALID_CARD_STATE 这类本地校验错误一律快速抛出，不重试。
# 0 是合法值，表示「不重试」。退避在 BASE_MS 与 MAX_MS 之间递增。
# LARK_API_RETRY_MAX_ATTEMPTS=3
# LARK_API_RETRY_BASE_MS=500
# LARK_API_RETRY_MAX_MS=8000
# 熔断：WINDOW_MS 窗口内累计 FAILURE_THRESHOLD 次失败即打开熔断，
# 之后每隔 PROBE_INTERVAL_MS 放一个探测请求试探恢复。
# LARK_API_CIRCUIT_FAILURE_THRESHOLD=5
# LARK_API_CIRCUIT_WINDOW_MS=30000
# LARK_API_CIRCUIT_PROBE_INTERVAL_MS=30000

# Optional custom agents. Entries with an existing built-in id override it.
# ACP commands must expose an ACP server over stdio. Custom Claude CLI commands
# use protocol=pty-cli and adapterId=claude-code; see README for ccflash/CPA examples.
DUTYDECK_AGENTS_JSON=[{"id":"custom","name":"Custom ACP","command":"/absolute/path/to/custom-agent","args":["acp","serve"],"protocol":"acp","cwd":"/absolute/path/to/project","env":{},"permissionMode":"ask","timeout":600,"capabilities":{"pause":false,"resume":true},"builtin":false}]
