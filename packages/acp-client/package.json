{
  "name": "@dutydeck/acp-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./provider": { "types": "./dist/provider.d.ts", "development": "./src/provider.ts", "import": "./dist/provider.js" },
    "./regex-timeout": {
      "types": "./dist/regex-timeout.d.ts",
      "development": "./src/regex-timeout.ts",
      "import": "./dist/regex-timeout.js"
    },
    "./transcript-source": {
      "types": "./dist/transcript-source.d.ts",
      "development": "./src/transcript-source.ts",
      "import": "./dist/transcript-source.js"
    },
    "./mock-agent": { "development": "./agents/mock-acp.mjs", "default": "./agents/mock-acp.mjs" },
    "./claude-agent": { "development": "./agents/claude-acp.mjs", "default": "./agents/claude-acp.mjs" }
  },
  "files": [
    "src/index.ts",
    "src/native-session-store.ts",
    "dist/native-session-store.js",
    "dist/native-session-store.js.map",
    "dist/native-session-store.d.ts",
    "src/provider.ts",
    "dist/provider.js",
    "dist/provider.js.map",
    "dist/provider.d.ts",
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts",
    "agents",
    "src/regex-timeout.ts",
    "dist/regex-timeout.js",
    "dist/regex-timeout.js.map",
    "dist/regex-timeout.d.ts",
    "src/process-cpu.ts",
    "dist/process-cpu.js",
    "dist/process-cpu.js.map",
    "dist/process-cpu.d.ts",
    "src/release-path.ts",
    "dist/release-path.js",
    "dist/release-path.js.map",
    "dist/release-path.d.ts",
    "src/transcript-source.ts",
    "dist/transcript-source.js",
    "dist/transcript-source.js.map",
    "dist/transcript-source.d.ts",
    "src/agent-process-tree.ts",
    "dist/agent-process-tree.js",
    "dist/agent-process-tree.js.map",
    "dist/agent-process-tree.d.ts",
    "src/agent-process-sampler.ts",
    "dist/agent-process-sampler.js",
    "dist/agent-process-sampler.js.map",
    "dist/agent-process-sampler.d.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "tsc -b --force",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.66.0",
    "@dutydeck/shared": "workspace:*",
    "acpx": "0.13.0"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
