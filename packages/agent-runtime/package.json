{
  "name": "@dutydeck/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dutydeck/shared": "workspace:*",
    "@dutydeck/acp-client": "workspace:*",
    "@dutydeck/transports": "workspace:*",
    "@dutydeck/storage": "workspace:*"
  },
  "devDependencies": {
    "acpx": "0.13.0",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
