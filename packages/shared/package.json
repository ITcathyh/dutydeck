{
  "name": "@dutydeck/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./child-environment": {
      "types": "./runtime/child-environment.d.mts",
      "import": "./runtime/child-environment.mjs"
    },
    "./secret-guard": {
      "types": "./runtime/secret-guard.d.mts",
      "import": "./runtime/secret-guard.mjs"
    },
    "./safe-git": {
      "types": "./runtime/safe-git.d.mts",
      "import": "./runtime/safe-git.mjs"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "dist",
    "runtime"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "safe-regex2": "5.1.1",
    "zod": "3.25.67",
    "@dutydeck/plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
